# Docker Compose
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_PORT=8080
ADMIN_EMAIL=admin@example.ru
# Не менее 12 символов. Обязательно замените перед публикацией.
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Для локального HTTP оставьте false; на сервере с HTTPS установите true.
COOKIE_SECURE=false
# Автоматическая проверка новостей старого сайта каждые 30 минут.
LEGACY_NEWS_SYNC_ENABLED=true

# Нужны только при запуске приложения без Docker.
DATABASE_URL=postgresql://ipi:replace-with-a-long-random-database-password@127.0.0.1:5432/ipi
PORT=3001
UPLOAD_DIR=./uploads
