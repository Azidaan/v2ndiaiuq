{
  "name": "guiaidn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite",
    "db:check": "node --env-file-if-exists=.env server/checkDatabaseIntegrity.mjs",
    "db:import-legacy-news": "node --env-file-if-exists=.env server/importLegacyNews.mjs",
    "db:import-news-2026": "node --env-file-if-exists=.env server/importNews2026.mjs --replace",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@radix-ui/react-slot": "1.1.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "^3.4.11",
    "fastify": "^5.10.0",
    "lucide-react": "0.487.0",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
